includes:
    - vendor/pollora/harness/presets/phpstan/base.neon

parameters:
    level: 5
    paths:
        - src
        - vocabulary

    # Attributes normalise what a project passes them (array_values() on a
    # list<string> parameter): the PHPDoc type is a promise, not a guarantee.
    treatPhpDocTypesAsCertain: false
